# Copy to app/.env.local and fill in. Never commit real values.

# Google Drive backup (optional). OAuth *client ID* for a "Web application" client in Google Cloud.
# This is a public identifier, not a secret; there is no client secret in AuthorDesk.
# Setup steps: docs/google-drive-setup.md
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
