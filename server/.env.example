# Environment for server/index.js. Do not commit real values.
PORT=8787
# Bind address. Keep 127.0.0.1 behind a reverse proxy / tailscale serve; never expose plain HTTP publicly.
HOST=127.0.0.1
# Where the SQLite database lives (contains your manuscripts — back it up, never commit it).
DATA_DIR=./data
# Built app to serve (defaults to ../app/dist).
APP_DIR=../app/dist
